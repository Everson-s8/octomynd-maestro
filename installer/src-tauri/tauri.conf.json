{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Maestro Setup",
  "version": "0.4.1",
  "identifier": "dev.octomynd.maestro.setup",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5176",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Maestro",
        "width": 880,
        "height": 620,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "center": true,
        "backgroundColor": "#161311"
      }
    ],
    "security": {
      "csp": "default-src 'self'; font-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
