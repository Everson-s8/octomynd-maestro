TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=
MAESTRO_PROJECT_NAME=octomynd-maestro
MAESTRO_DB_PATH=.maestro/maestro.db
# On Windows the default is C:\MaestroRuntime\<project>\worktrees.
# Override both only with a dedicated, non-synced execution location.
MAESTRO_EXECUTION_ROOT=C:\MaestroRuntime\octomynd-maestro
MAESTRO_WORKTREES_PATH=C:\MaestroRuntime\octomynd-maestro\worktrees
MAESTRO_NODE_VERSION=20.17.0
MAESTRO_DASHBOARD_ENABLED=true
MAESTRO_DASHBOARD_HOST=127.0.0.1
MAESTRO_DASHBOARD_PORT=4787
MAESTRO_AUTOPILOT_ENABLED=true
MAESTRO_AUTOPILOT_POLL_MS=30000
MAESTRO_AUTOPILOT_MAX_CONCURRENT=1
MAESTRO_TOKEN_RUNTIME_ENABLED=true
# Optional Provider API Key overrides (plug-and-play without CLI binary logins)
# CODEX_API_KEY=
# OPENAI_API_KEY=
# CLAUDE_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# GOOGLE_API_KEY=
# Antigravity uses the signed-in Google subscription; no API key is required if CLI is present.
MAESTRO_ANTIGRAVITY_ENABLED=true
# Leave empty to use the account default model.
MAESTRO_ANTIGRAVITY_MODEL=
MAESTRO_CODEX_MODEL=
MAESTRO_CLAUDE_MODEL=
MAESTRO_ANTIGRAVITY_EFFORT=medium
MAESTRO_ANTIGRAVITY_INACTIVITY_TIMEOUT_MS=1800000
# Provider execution is bounded by inactivity, not a short total wall-clock limit.
MAESTRO_CODEX_INACTIVITY_TIMEOUT_MS=600000
MAESTRO_CLAUDE_INACTIVITY_TIMEOUT_MS=1800000
# Optional emergency policies. Leave empty to allow active work to continue.
MAESTRO_PROVIDER_MAX_RUNTIME_MS=
MAESTRO_GOAL_DEADLINE_MS=
# Work Graph adoption modes: off, shadow, explicit. Execution remains linear until governed coordination ships.
MAESTRO_WORK_GRAPH_MODE=off
# Governed Skills remain disabled until explicitly enabled.
MAESTRO_SKILLS_ENABLED=false
MAESTRO_SKILLS_PATH=skills
MAESTRO_SKILL_VERSIONS_PATH=.maestro/skill-versions
MAESTRO_SKILLS_PROJECT_KEY=maestro
